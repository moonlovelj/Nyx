<?xml version="1.0" encoding="utf-8"?>
<Project xmlns="http://schemas.microsoft.com/developer/msbuild/2003">
  <PropertyGroup>
    <NyxDlssRoot>$(MSBuildThisFileDirectory)..\ThirdParty\DLSS\</NyxDlssRoot>
    <NyxDlssRuntime>$(NyxDlssRoot)lib\Windows_x86_64\rel\nvngx_dlss.dll</NyxDlssRuntime>
    <NyxDlssLibrary>$(NyxDlssRoot)lib\Windows_x86_64\x64\nvsdk_ngx_d.lib</NyxDlssLibrary>
    <NyxDlssLibrary Condition="'$(Configuration)'=='Debug'">$(NyxDlssRoot)lib\Windows_x86_64\x64\nvsdk_ngx_d_dbg.lib</NyxDlssLibrary>
    <NyxEnableDlss Condition="'$(NyxEnableDlss)'=='' And '$(Platform)'=='x64' And Exists('$(NyxDlssRoot)include\nvsdk_ngx.h') And Exists('$(NyxDlssLibrary)')">true</NyxEnableDlss>
    <NyxEnableDlss Condition="'$(NyxEnableDlss)'==''">false</NyxEnableDlss>
  </PropertyGroup>
  <ItemDefinitionGroup>
    <ClCompile>
      <PreprocessorDefinitions Condition="'$(NyxEnableDlss)'=='true'">NYX_ENABLE_DLSS=1;%(PreprocessorDefinitions)</PreprocessorDefinitions>
      <PreprocessorDefinitions Condition="'$(NyxEnableDlss)'!='true'">NYX_ENABLE_DLSS=0;%(PreprocessorDefinitions)</PreprocessorDefinitions>
    </ClCompile>
    <Link Condition="'$(NyxEnableDlss)'=='true'">
      <AdditionalDependencies>$(NyxDlssLibrary);%(AdditionalDependencies)</AdditionalDependencies>
    </Link>
  </ItemDefinitionGroup>
  <Target Name="NyxValidateDlssConfiguration" BeforeTargets="PrepareForBuild">
    <Error Condition="'$(NyxEnableDlss)'!='true' And '$(NyxEnableDlss)'!='false'"
           Text="NyxEnableDlss must be true or false." />
    <Error Condition="'$(NyxEnableDlss)'=='true' And ('$(Platform)'!='x64' Or !Exists('$(NyxDlssRoot)include\nvsdk_ngx.h') Or !Exists('$(NyxDlssLibrary)'))"
           Text="DLSS requires x64 and the pinned SDK submodule. Run git submodule update --init MiniEngine/ThirdParty/DLSS, or build with /p:NyxEnableDlss=false." />
  </Target>
  <Target Name="NyxCopyDlssRuntime" AfterTargets="Build"
          Condition="'$(ConfigurationType)'=='Application'">
    <Copy SourceFiles="$(NyxDlssRuntime)"
          DestinationFolder="$(OutDir)" SkipUnchangedFiles="true"
          Condition="'$(NyxEnableDlss)'=='true' And Exists('$(NyxDlssRuntime)')" />
    <Warning Text="DLSS runtime missing; DLAA/DLSS will fall back to TAA."
             Condition="'$(NyxEnableDlss)'=='true' And !Exists('$(NyxDlssRuntime)')" />
    <WriteLinesToFile File="$(OutDir)NyxDlssBuild.txt" Overwrite="true" WriteOnlyWhenDifferent="true"
                      Lines="Enabled=$(NyxEnableDlss);Configuration=$(Configuration);Platform=$(Platform)" />
  </Target>
</Project>
