# Normalize text files and enforce lf for VS-visible sources/projects.
* text=auto

*.sln text eol=lf
*.vcxproj text eol=lf
*.vcxproj.filters text eol=lf
*.vcxproj.user text eol=lf
*.props text eol=lf
*.targets text eol=lf
*.natvis text eol=lf

*.c text eol=lf
*.cc text eol=lf
*.cpp text eol=lf
*.cxx text eol=lf
*.h text eol=lf
*.hpp text eol=lf
*.inl text eol=lf
*.hlsl text eol=lf
*.hlsli text eol=lf

*.bat text eol=lf
*.cmd text eol=lf
*.ps1 text eol=lf
