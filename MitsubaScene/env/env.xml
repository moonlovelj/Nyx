<scene version="3.0.0">

<!-- Defaults, these can be set via the command line: -Darg=value -->

	<default name="spp" value="1024"/>
	<default name="resx" value="1920"/>
	<default name="resy" value="1080"/>

<!-- Camera and Rendering Parameters -->

	<integrator type="path" id="elm__0" name="elm__0">
		<integer name="max_depth" value="12"/>
	</integrator>
	<sensor type="perspective" id="elm__1" name="elm__1">
		<string name="fov_axis" value="y"/>
		<float name="fov" value="34.515876"/>
		<float name="principal_point_offset_x" value="0.000000"/>
		<float name="principal_point_offset_y" value="-0.000000"/>
		<float name="near_clip" value="0.001000"/>
		<float name="far_clip" value="200.000000"/>
		<transform name="to_world">
			<rotate x="1" angle="-171.15034746742424"/>
			<rotate y="1" angle="0.5536111114175988"/>
			<rotate z="1" angle="-179.999991348578"/>
			<translate value="-0.759908 7.708761 27.743376"/>
		</transform>
		<sampler type="multijitter" name="sampler">
			<integer name="sample_count" value="$spp"/>
		</sampler>
		<film type="hdrfilm" name="film">
			<integer name="width" value="$resx"/>
			<integer name="height" value="$resy"/>
		</film>
	</sensor>

<!-- Materials -->

	<bsdf type="principled" id="mat-MetallicSpheresMat" name="mat-MetallicSpheresMat"> 
		<rgb name="base_color" value="1.0,1.0,1.0"/>
		<float name="metallic" value="1.0" />
		<float name="specular" value="0.5" />
		<!-- <float name="roughness" value="0.17" /> -->
		<texture name="roughness" type="bitmap">
        	<string name="filename" value="roughness.png"/>
        	<boolean name="raw" value="true"/>
    	</texture> 
		<float name="spec_tint" value="0.0" />
		<float name="anisotropic" value="0.0" />
		<float name="sheen" value="0.0" />
		<float name="sheen_tint" value="0.0" />
		<float name="clearcoat" value="0.0" />
		<float name="clearcoat_gloss" value="0.0" />
		<float name="spec_trans" value="0.0" />
	</bsdf>

	<bsdf type="principled" id="mat-DielectricSpheresMat" name="mat-DielectricSpheresMat"> 
		<rgb name="base_color" value="1.0,1.0,1.0"/>
		<float name="metallic" value="0.0" />
		<float name="specular" value="0.5" />
		<texture name="roughness" type="bitmap">
        	<string name="filename" value="roughness.png"/>
			<boolean name="raw" value="true"/>
    	</texture> 
		<float name="spec_tint" value="0.0" />
		<float name="anisotropic" value="0.0" />
		<float name="sheen" value="0.0" />
		<float name="sheen_tint" value="0.0" />
		<float name="clearcoat" value="0.0" />
		<float name="clearcoat_gloss" value="0.0" />
		<float name="spec_trans" value="0.0" />
	</bsdf>


	<bsdf type="principled" id="mat-DielectricSpheresMat.001" name="mat-DielectricSpheresMat.001">
		<rgb name="base_color" value="0.0,0.0,0.0"/>
		<float name="metallic" value="0.0" />
		<float name="specular" value="0.5" />
		<texture name="roughness" type="bitmap">
        	<string name="filename" value="roughness.png"/>
			<boolean name="raw" value="true"/>
    	</texture> 
		<float name="spec_tint" value="0.0" />
		<float name="anisotropic" value="0.0" />
		<float name="sheen" value="0.0" />
		<float name="sheen_tint" value="0.0" />
		<float name="clearcoat" value="0.0" />
		<float name="clearcoat_gloss" value="0.0" />
		<float name="spec_trans" value="0.0" />
	</bsdf>

	<bsdf type="diffuse" id="mat-diffuse" name="mat-diffuse">
		<rgb name="reflectance" value="1 1 1"/>
	</bsdf>

	<!-- <bsdf type="roughdiffuse" id="mat-roughdiffuse" name="mat-roughdiffuse">
		<rgb name="reflectance" value="1 1 1"/>
		<texture name="alpha" type="bitmap">
        	<string name="filename" value="roughness_0.png"/>
    	</texture>
	</bsdf> -->

<!-- Emitters -->
<emitter type="envmap">
    <!-- HDRI 贴图 -->
    <string name="filename" value="derelict_airfield_02_4k.exr"/>
</emitter>


<!-- Shapes -->

	<shape type="ply" id="elm__3" name="elm__3">
		<string name="filename" value="meshes/Metallic0.ply"/>
